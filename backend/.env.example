NODE_ENV=development
PORT=4000

# Supabase (Postgres + Storage + Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scan-photos

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins for the frontend (e.g. https://app.nutriscan.ai). "*" allows any origin (dev only).
CORS_ORIGIN=*

# Food recognition provider: "mock" | "logmeal" | "gemini" (free tier key from aistudio.google.com, same key as AI_INSIGHT_PROVIDER)
FOOD_RECOGNITION_PROVIDER=mock
LOGMEAL_API_KEY=
LOGMEAL_BASE_URL=https://api.logmeal.com/v2

# AI nutrition insight provider: "mock" | "gemini" (free tier key from aistudio.google.com)
AI_INSIGHT_PROVIDER=mock
# AI Coach chatbot provider: "mock" | "gemini" (same GEMINI_API_KEY)
AI_CHAT_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Business rules (see SRS 2.1 / 2.4)
MAX_UPLOAD_SIZE_BYTES=8388608
MIN_IMAGE_DIMENSION_PX=300
LOW_CONFIDENCE_THRESHOLD=0.6
SCAN_TIMEOUT_MS=10000
PHOTO_RETENTION_DAYS=30
